<style>
  body {
    background: black;
  }

  iframe {
    width: 100%;
    height: 100%;
  }
</style>

<%= if @iframe do %>
  <style>
    @font-face {
      font-family: Manrope;
      src: url('<%= ~p"/fonts/Manrope/Manrope.ttf" %>') format('truetype');
      font-weight: 200 800;
      font-display: swap;
    }

    body, #presenter #slides, #presenter #post-list, #presenter #pinned-post-list {
      background-color: #0B2545;
      color: #fff;
      font-family: Manrope, Arial, sans-serif;
    }

    #presenter #poll, #presenter #word-cloud {
      padding: 1rem 0;
      background-color: #0B2545;
      overflow-y: auto;
    }

    #presenter #poll > div, #presenter #word-cloud > div {
      width: 80%;
    }

    #presenter #poll p {
      margin-bottom: 1.25rem;
    }

    #presenter #poll .rounded-3xl {
      border-radius: 14px;
      background-color: #1C3A63;
    }

    #presenter #poll .rounded-3xl > .rounded-3xl {
      background-color: #FDC500;
    }

    #presenter #poll .z-10 {
      color: #fff;
      background-color: #0B2545;
      border-radius: 6px;
      padding: 0 0.35rem;
      overflow-wrap: anywhere;
    }

    #presenter[data-join-only] {
      position: relative;
      min-height: 100vh;
    }

    #presenter[data-join-only] > :not(#joinScreen) {
      display: none;
    }

    #presenter #joinScreen > div {
      gap: clamp(0.35rem, 2vh, 1rem);
      padding: 0.5rem;
      background-color: #EAF0F7;
      color: #0B2545;
    }

    #presenter #joinScreen span {
      font-size: clamp(1rem, 5vh, 1.65rem);
      margin-bottom: 0;
    }

    #presenter #qr {
      margin-bottom: 0;
    }

    #presenter #joinScreen canvas {
      max-height: 48vh;
      max-width: 48vh;
    }
  </style>
<% end %>

<div
  id="presenter"
  data-join-only={if @join_only, do: "true"}
  phx-hook={if !@join_only, do: "Presenter"}
  data-max-page={@event.presentation_file.length || 0}
  data-hash={@event.presentation_file.hash}
  data-goto-position={@goto_position}
  data-current-page={@state.position}
  data-embed-active={if @current_embed, do: "true", else: "false"}
>
  <!-- JOIN SCREEN -->
  <div
    id="joinScreen"
    class={"#{if @join_only || (@state.join_screen_visible && !(@iframe && @goto_position == @state.position)), do: "opacity-100 z-40", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-black absolute transition-opacity"}
  >
    <div class="h-full bg-white text-black text-center flex flex-col items-center justify-center">
      <span class="font-semibold mb-10 sm:text-3xl md:text-4xl lg:text-6xl">
        {gettext("Scan to interact in real-time")}
      </span>
      <div
        phx-hook="QRCode"
        data-code={@event.code}
        data-dynamic="true"
        id="qr"
        phx-update="ignore"
        class="rounded-lg mx-auto flex items-center justify-center mb-14"
      >
      </div>
      <span class="font-semibold mb-10 sm:text-3xl md:text-4xl lg:text-6xl">
        {gettext("Or go to %{url} and use the code:", url: @host)}
      </span>
      <span class="font-semibold mb-10 sm:text-5xl md:text-6xl lg:text-8xl">
        #{String.upcase(@event.code)}
      </span>
    </div>
  </div>
  <!-- POLL -->
  <%= if @current_poll do %>
    <div
      id="poll"
      class={"#{if (@state.poll_visible || (@iframe && @goto_position == @state.position)), do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-black/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"}
    >
      <div class="w-full md:w-1/2 mx-auto h-full">
        <p class={"#{if @iframe, do: "text-xl mb-12", else: "text-5xl mb-24"} text-white font-bold  text-center"}>
          {@current_poll.title}
        </p>

        <div class={"#{if @iframe, do: "space-y-5", else: "space-y-8"} flex flex-col"}>
          <%= if (length @current_poll.poll_opts) > 0 do %>
            <%= for opt <- @current_poll.poll_opts do %>
              <div class={"#{if @iframe, do: "py-1", else: "py-4"} bg-gray-500 px-6 rounded-3xl flex justify-between items-center relative text-white"}>
                <div
                  style={"width: #{opt.percentage}%;"}
                  class="bg-primary rounded-3xl h-full absolute left-0 transition-all"
                >
                </div>
                <div class="flex space-x-3 z-10 text-left">
                  <span class={"#{if @iframe, do: "text-base", else: "text-2xl"} flex-1 font-bold pr-2"}>
                    {opt.content}
                  </span>
                </div>
                <span class={"#{if @iframe, do: "text-base", else: "text-2xl"} z-10 font-bold"}>
                  {opt.percentage}% ({opt.vote_count})
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <!-- QUIZ -->
  <%= if @current_quiz do %>
    <.live_component
      module={ClaperWeb.EventLive.ManageableQuizComponent}
      id={"#{@current_quiz.id}-quiz"}
      quiz={@current_quiz}
      iframe={@iframe}
    />
  <% end %>
  <!-- WORD CLOUD -->
  <div
    :if={@current_word_cloud}
    id="word-cloud"
    class={"#{if (@state.poll_visible || (@iframe && @goto_position == @state.position)), do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-black/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"}
  >
    <div class="w-full mx-auto h-full flex flex-col justify-center">
      <header class={[
        "border-b border-gray-700 text-center",
        if(@iframe, do: "mb-6 pb-4", else: "mb-10 pb-6")
      ]}>
        <h2 class={[
          "text-gray-300 font-semibold leading-tight",
          if(@iframe, do: "text-2xl", else: "text-[clamp(2.5rem,4vw,8rem)]")
        ]}>
          {@current_word_cloud.title}
        </h2>
      </header>

      <ClaperWeb.Component.WordCloud.cloud
        id={"word-cloud-#{@current_word_cloud.id}-words"}
        words={@word_cloud_words}
        text_color="var(--color-primary-200)"
        class={[
          "w-full",
          if(@iframe,
            do: "[--presenter-word-scale:1.25]",
            else:
              "[--presenter-word-scale:2] 2xl:[--presenter-word-scale:3] min-[160rem]:[--presenter-word-scale:4]"
          )
        ]}
      />
    </div>
  </div>
  <!-- MESSAGES -->
  <div
    :if={!@join_only}
    id="slider-wrapper"
    class={"w-full min-h-screen grid #{if (@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (@current_embed && (@event.presentation_file.length || 0) == 0), do: "grid-cols-[1fr_10px_1fr]", else: "grid-cols-[1fr]"} items-center justify-center relative bg-black"}
    phx-hook="Split"
    data-type="column"
    data-gutter=".gutter-1"
  >
    <div
      :if={@state.chat_visible}
      class="px-5 transition-all duration-150 flex flex-col h-screen py-5 justify-end max-h-screen bg-black"
      id="post-list-wrapper"
      phx-update="replace"
    >
      <%= if @state.show_only_pinned == false do %>
        <div id="post-list" phx-update="replace">
          <%= for post <- @posts do %>
            <div class={if post.__meta__.state == :deleted, do: "hidden"} id={"#{post.id}-post"}>
              <div class="px-4 pb-2 pt-3 rounded-b-lg rounded-tr-lg bg-white shadow-md text-black break-word mt-4">
                <%= if post.name do %>
                  <p class={"#{if @iframe, do: "text-base", else: "text-lg"} text-gray-400 font-semibold mb-2 mr-2"}>
                    {post.name}
                  </p>
                <% end %>
                <p class={"#{if @iframe, do: "text-xl", else: "text-3xl"}"}>{post.body}</p>

                <.presenter_reply_count
                  :if={post.replies != []}
                  count={length(post.replies)}
                  iframe={@iframe}
                />

                <%= if post.like_count > 0 || post.love_count > 0 || post.lol_count > 0 do %>
                  <div class="flex h-6 space-x-2 text-lg text-gray-500 pb-3 items-center mt-5">
                    <div class="flex items-center">
                      <%= if post.like_count > 0 do %>
                        <img
                          src="/images/icons/thumb.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.like_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.love_count > 0 do %>
                        <img
                          src="/images/icons/heart.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.love_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.lol_count > 0 do %>
                        <img
                          src="/images/icons/laugh.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.lol_count}</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div id="pinned-posts" phx-update="replace">
          <%= for post <- @pinned_posts do %>
            <div class={if post.__meta__.state == :deleted, do: "hidden"} id={"#{post.id}-post"}>
              <div class="px-4 pb-2 pt-3 rounded-b-lg rounded-tr-lg bg-white shadow-md text-black break-word mt-4">
                <%= if post.name do %>
                  <p class={"#{if @iframe, do: "text-base", else: "text-lg"} text-gray-400 font-semibold mb-2 mr-2"}>
                    {post.name}
                  </p>
                <% end %>
                <p class={"#{if @iframe, do: "text-xl", else: "text-3xl"}"}>{post.body}</p>

                <.presenter_reply_count
                  :if={post.replies != []}
                  count={length(post.replies)}
                  iframe={@iframe}
                />

                <%= if post.like_count > 0 || post.love_count > 0 || post.lol_count > 0 do %>
                  <div class="flex h-6 space-x-2 text-lg text-gray-500 pb-3 items-center mt-5">
                    <div class="flex items-center">
                      <%= if post.like_count > 0 do %>
                        <img
                          src="/images/icons/thumb.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.like_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.love_count > 0 do %>
                        <img
                          src="/images/icons/heart.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.love_count}</span>
                      <% end %>
                    </div>
                    <div class="flex items-center">
                      <%= if post.lol_count > 0 do %>
                        <img
                          src="/images/icons/laugh.svg"
                          class={"#{if @iframe, do: "h-4", else: "h-7"}"}
                        />
                        <span class="ml-1">{post.lol_count}</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div
      class={"gutter-1 row-span-full cursor-col-resize col-2 text-center text-sm leading-3 text-white #{if (!@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (!@current_embed && (@event.presentation_file.length || 0) == 0), do: "hidden"}"}
      style="writing-mode: vertical-rl"
    >
      •••
    </div>
    <!-- SLIDES -->
    <div id="slides">
      <%= if @current_embed do %>
        <!-- EMBED -->
        <div id="embed" class="max-h-screen w-full h-screen">
          <.live_component
            id="embed-component"
            module={ClaperWeb.EventLive.EmbedIframeComponent}
            provider={@current_embed.provider}
            content={@current_embed.content}
            title={@current_embed.title}
          />
        </div>
      <% end %>
      <%= if @iframe do %>
        <% src =
          iframe_slide_url(
            @event.presentation_file,
            @initial_iframe_position || @state.position
          ) %>
        <div class={[if(@current_embed, do: "hidden"), "text-center"]}>
          <img :if={src} id="current-slide" src={src} class="max-h-screen w-auto!" />
        </div>
      <% else %>
        <div
          class={"#{if @current_embed, do: "hidden", else: ""} text-center"}
          id="slider"
          phx-update="ignore"
        >
          <img
            :for={src <- Presentations.get_slide_urls(@event.presentation_file)}
            src={src}
            class="max-h-screen w-auto!"
          />
        </div>
      <% end %>
    </div>
  </div>
  <div
    :if={!@iframe}
    id="reacts"
    phx-hook="GlobalReacts"
    data-class-name="h-24"
    class="fixed right-5 bottom-5 z-30 w-24 pointer-events-none"
    phx-update="ignore"
  >
  </div>
  
<!-- ONLINE BADGE -->
  <div
    :if={!@iframe && @state.show_attendee_count}
    class="absolute z-20 bottom-5 right-5 px-4 pt-3 pb-1 rounded-md bg-black shadow-md text-white flex-1"
  >
    <div class="inline-flex justify-between items-center text-white text-2xl">
      <img src="/images/icons/online-users.svg" class="h-12 mr-2" />
      <span id="counter" phx-hook="UpdateAttendees" phx-update="ignore">
        {@attendees_nb}
      </span>
    </div>
  </div>
</div>
<!-- TRANSCRIPTION SUBTITLES (outside #presenter to avoid slider re-init on text updates) -->
<div
  :if={!@join_only}
  id="transcription-subtitles"
  class="fixed z-50 bottom-16 left-1/2 transform -translate-x-1/2 max-w-3xl w-full px-4"
>
  <div
    :if={
      @transcription_config && @transcription_config.enabled &&
        @transcription_config.visibility in ["both", "presenter"] && @transcription_text != ""
    }
    class="bg-black/80 rounded-lg px-6 py-3 text-center"
  >
    <p class={"#{if @iframe, do: "text-lg", else: "text-2xl"} text-white font-medium"}>
      {@transcription_text}
    </p>
  </div>
</div>
