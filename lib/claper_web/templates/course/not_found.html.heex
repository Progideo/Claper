<main class="mx-auto max-w-lg p-6">
  <h1 class="text-xl font-semibold">
    {gettext("No active session is shared with this account for %{course}", course: @course)}
  </h1>
  <p class="mt-3">
    {gettext(
      "Ask for a copy of the course event template and have this account added as a facilitator."
    )}
  </p>
  <p class="mt-4 break-all">
    {gettext("Signed in as %{email}", email: @email)}
  </p>
  <.form for={%{}} action={@switch_path} method="post" class="mt-2">
    <button type="submit" class="link link-primary">{gettext("Switch account")}</button>
  </.form>
</main>
